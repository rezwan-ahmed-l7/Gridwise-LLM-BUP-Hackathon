# GridWise LLM — Environment configuration
# Copy this file to `.env` and fill in your real values.

# --- LLM (optional) -------------------------------------------------------
# Without GEMINI_API_KEY the service runs in deterministic NLP fallback mode.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated fallback models used if the primary model fails.
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash
LLM_TIMEOUT_SECONDS=12

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
